{% comment %}
  Theme Block: Benchmark Specification Item
{% endcomment %}
<div class="theme-block theme-block--spec-item" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 24px; transition: border-color 0.2s;" {{ block.shopify_attributes }}>
  <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(255, 217, 0, 0.1); border: 1px solid rgba(255, 217, 0, 0.25); display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
    <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 24px;">{{ block.settings.icon | default: 'wb_sunny' }}</span>
  </div>
  <h3 style="font-size: 18px; font-weight: 800; text-transform: uppercase; color: #fff; margin: 0 0 8px 0;">
    {{ block.settings.title | default: '15,000 Lumens' }}
  </h3>
  <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.5; margin: 0;">
    {{ block.settings.text | default: 'Ultra-focused CSP LED chips deliver razor-sharp cutoff lines with zero stray glare.' }}
  </p>
</div>

{% schema %}
{
  "name": "Benchmark Spec Item",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "15,000 Lumens"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Ultra-focused CSP LED chips deliver razor-sharp cutoff lines with zero stray glare."
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Material Icon Name",
      "default": "wb_sunny"
    }
  ],
  "presets": [
    {
      "name": "Benchmark Spec Item"
    }
  ]
}
{% endschema %}
