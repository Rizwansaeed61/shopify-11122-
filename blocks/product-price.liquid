{% comment %}
  Theme Block: Product Price
{% endcomment %}
<div class="theme-block theme-block--product-price" {{ block.shopify_attributes }}>
  <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 8px;">
    <span style="font-size: 32px; font-weight: 900; color: var(--color-primary); letter-spacing: -0.02em;">
      {{ product.selected_or_first_available_variant.price | default: 8900 | money }}
    </span>
    {%- if product.compare_at_price > product.price or product == blank -%}
      <span style="font-size: 18px; color: var(--color-text-muted); text-decoration: line-through;">
        {{ product.compare_at_price | default: 12900 | money }}
      </span>
      <span style="background: #eb001b; color: #fff; font-size: 11px; font-weight: 900; padding: 3px 8px; border-radius: var(--radius-full); text-transform: uppercase;">
        SAVE 31%
      </span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Price",
  "settings": [],
  "presets": [
    {
      "name": "Product Price"
    }
  ]
}
{% endschema %}
