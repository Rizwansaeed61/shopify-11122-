<section class="collection-page" style="padding: 80px 0; background: #12110c;">
  <div class="page-width">
    
    <div style="margin-bottom: 48px; border-bottom: 1px solid var(--color-border); padding-bottom: 24px;">
      <h1 style="font-size: clamp(32px, 5vw, 56px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em;">
        {{ collection.title | default: 'ALL AUTOMOTIVE LED PRODUCTS' }}
      </h1>
      {%- if collection.description != blank -%}
        <p style="font-size: 16px; color: var(--color-text-muted); margin-top: 12px; max-width: 800px;">
          {{ collection.description }}
        </p>
      {%- endif -%}
    </div>

    <!-- Product Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-card', title: 'Electro NightEye LED H4 (Dual Beam)', price: 8900, lumens: '15,000 LM' %}
        {% render 'product-card', title: 'Electro NightEye LED H7 (Low/High)', price: 8900, lumens: '15,000 LM' %}
        {% render 'product-card', title: 'Electro NightEye LED HB3 / 9005', price: 9500, lumens: '16,000 LM' %}
        {% render 'product-card', title: 'Electro NightEye LED H11 (Fog/Low)', price: 8900, lumens: '15,000 LM' %}
        {% render 'product-card', title: 'Electro NightEye LED HB4 / 9006', price: 8900, lumens: '15,000 LM' %}
        {% render 'product-card', title: 'Electro NightEye LED H1 (High Beam)', price: 8500, lumens: '14,000 LM' %}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
