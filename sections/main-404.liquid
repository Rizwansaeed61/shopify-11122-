<section class="error-404" style="padding: 120px 0; background: #12110c; text-align: center;">
  <div class="page-width" style="max-width: 600px;">
    <span style="font-size: 80px; font-weight: 900; color: var(--color-primary); line-height: 1;">404</span>
    <h1 style="font-size: 32px; font-weight: 900; text-transform: uppercase; margin: 16px 0 20px;">Page Not Found</h1>
    <p style="color: var(--color-text-muted); margin-bottom: 32px;">The page you requested could not be found. Check the URL or head back home.</p>
    <a href="/" class="btn-primary">Return to Homepage</a>
  </div>
</section>

{% schema %}
{
  "name": "Main 404",
  "settings": []
}
{% endschema %}
