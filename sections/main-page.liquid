<section class="page-content" style="padding: 80px 0; background: #12110c; min-height: 60vh;">
  <div class="page-width" style="max-width: 800px;">
    <h1 style="font-size: 38px; font-weight: 900; text-transform: uppercase; margin-bottom: 24px; border-bottom: 1px solid var(--color-border); padding-bottom: 16px;">
      {{ page.title }}
    </h1>
    <div style="font-size: 16px; line-height: 1.8; color: var(--color-text-muted);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Page",
  "settings": []
}
{% endschema %}
