<section class="cart-page" style="padding: 80px 0; background: #12110c; min-height: 60vh;">
  <div class="page-width" style="max-width: 800px;">
    
    <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 24px; margin-bottom: 36px;">
      <h1 style="font-size: 36px; font-weight: 900; text-transform: uppercase;">
        {{ 'sections.cart.title' | t }}
      </h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="/cart" method="post" novalidate>
        <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px;">
          {%- for item in cart.items -%}
            <div class="glass-panel" style="display: flex; gap: 20px; padding: 24px; border-radius: var(--radius-md); align-items: center;">
              <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title }}" width="80" height="80" style="border-radius: var(--radius-sm); object-fit: cover;">
              <div style="flex: 1;">
                <h3 style="font-size: 16px; font-weight: 800; text-transform: uppercase;">{{ item.product.title }}</h3>
                <p style="font-size: 13px; color: var(--color-text-muted);">{{ item.variant.title }}</p>
                <div style="font-size: 16px; font-weight: 900; color: var(--color-primary); margin-top: 8px;">{{ item.final_line_price | money }}</div>
              </div>
              <div style="display: flex; align-items: center; gap: 16px;">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 50px; background: var(--color-surface-elevated); border: 1px solid var(--color-border); color: #fff; text-align: center; border-radius: 6px; padding: 6px;">
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: #ff5555;">
                  <span class="material-symbols-outlined">delete</span>
                </a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 16px; border-top: 1px solid var(--color-border); padding-top: 24px;">
          <div style="font-size: 20px; font-weight: 900;">
            <span>{{ 'sections.cart.subtotal' | t }}: </span>
            <span style="color: var(--color-primary);">{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" name="checkout" class="btn-primary" style="padding: 16px 40px; font-size: 15px;">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </div>
      </form>
    {%- else -%}
      <div style="text-align: center; padding: 60px 0;">
        <span class="material-symbols-outlined" style="font-size: 64px; color: var(--color-primary); margin-bottom: 16px;">remove_shopping_cart</span>
        <p style="font-size: 18px; color: var(--color-text-muted); margin-bottom: 24px;">
          {{ 'sections.cart.empty' | t }}
        </p>
        <a href="/collections/all" class="btn-primary">
          {{ 'sections.cart.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
