<section class="feature-spotlight" style="padding: 100px 0; background: #181710; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); position: relative;">
  <div class="page-width">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; align-items: center;">
      
      <!-- Visual Column -->
      <div style="display: flex; justify-content: center; position: relative;">
        <div style="position: absolute; inset: -20px; background: radial-gradient(circle, rgba(255,217,0,0.15), transparent 70%); filter: blur(30px); border-radius: 50%;"></div>
        <div class="neon-border" style="position: relative; z-index: 2; width: 100%; max-width: 440px; aspect-ratio: 1; border-radius: var(--radius-lg); overflow: hidden; background: #23200f; display: flex; align-items: center; justify-content: center;">
          {%- if section.settings.image != blank -%}
            {%- assign img_height = 800 | divided_by: section.settings.image.aspect_ratio | round -%}
            <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" width="800" height="{{ img_height }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
          {%- else -%}
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAND8qMhd2pMpwyXo2dJR417sLYkrXtb3jG7hFgq91krJo7_DVFtACJaJoMZIj1Sdms2xakavJlHGCoI8U4KgKk7BBUTG3QCTBn7WL9Tlm3GOoRi4Kxml7I0Vxso9dESfsxELI-wTQrkMKb1Px77sRRrrwIg48vuTF9SxSP2y5cG6Aq6Kj4DSweRaKFdxn_yU6Q0FSmmWGp1GdUVpoIkZ88Rr9GIWKxuHrM6zXzunCN0RfGAEWH7pUPmcArPrbMgwgvT4DDXc-b2v5N" alt="Mascot / Product Feature" width="440" height="440" loading="lazy" style="width: 100%; height: 100%; object-fit: contain;">
          {%- endif -%}
        </div>
      </div>

      <!-- Text & Features Column -->
      <div style="display: flex; flex-direction: column; gap: 32px;">
        <div>
          <span style="font-size: 12px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: 8px;">
            {{ section.settings.eyebrow | default: 'SUPERIOR ROAD VISIBILITY' }}
          </span>
          <h2 style="font-size: clamp(32px, 5vw, 64px); font-weight: 900; line-height: 1.05; text-transform: uppercase; letter-spacing: -0.03em;">
            {{ section.settings.title | default: 'OWN THE <span style="color: var(--color-primary);">NIGHT</span>' }}
          </h2>
          <p style="font-size: 16px; color: var(--color-text-muted); margin-top: 16px; line-height: 1.6;">
            {{ section.settings.description | default: 'Dominate the darkness with industrial-grade precision. Our LED systems are engineered for the bold who refuse to let the sun dictate their journey.' }}
          </p>
        </div>

        <!-- Dynamic Feature Blocks -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
          {%- for block in section.blocks -%}
            <div style="display: flex; gap: 16px; align-items: flex-start;" {{ block.shopify_attributes }}>
              <div style="width: 48px; height: 48px; border-radius: var(--radius-full); background: rgba(255, 217, 0, 0.1); border: 1px solid rgba(255, 217, 0, 0.3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--color-primary);">
                <span class="material-symbols-outlined">{{ block.settings.icon | default: 'bolt' }}</span>
              </div>
              <div>
                <h3 style="font-size: 16px; font-weight: 800; text-transform: uppercase; margin-bottom: 4px;">
                  {{ block.settings.heading }}
                </h3>
                <p style="font-size: 14px; color: var(--color-text-muted);">
                  {{ block.settings.text }}
                </p>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.button_text != blank -%}
          <div>
            <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="btn-primary">
              {{ section.settings.button_text }}
            </a>
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "SUPERIOR ROAD VISIBILITY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "OWN THE <span style='color: #ffd900;'>NIGHT</span>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Dominate the darkness with industrial-grade precision. Our LED systems are engineered for the bold who refuse to let the sun dictate their journey."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Spotlight Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "VIEW SPECIFICATIONS"
    },
    {
      "type": "text",
      "id": "button_url",
      "label": "Button Link",
      "default": "#specs"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Point",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Google Material Symbol)",
          "default": "bolt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Feature Title",
          "default": "Extreme Brightness"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Description",
          "default": "Ultra-focused beam pattern delivers maximum clarity without blinding oncoming traffic."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Spotlight",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "bolt",
            "heading": "Extreme Brightness",
            "text": "Ultra-focused beam delivers maximum clarity without oncoming glare."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "water_drop",
            "heading": "Storm Proof IP68",
            "text": "Tested in extreme monsoon conditions and high-pressure jet washes."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "settings_suggest",
            "heading": "Plug & Play Direct Fit",
            "text": "Instant 1:1 OEM headlight socket replacement with zero wire modification."
          }
        }
      ]
    }
  ]
}
{% endschema %}
