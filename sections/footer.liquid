<footer class="site-footer" style="background: #0d0c08; border-top: 1px solid var(--color-border); padding: 80px 0 40px; color: var(--color-text-muted);">
  <div class="page-width">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 48px; margin-bottom: 60px;">
      
      <!-- Col 1: Brand About -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--color-primary); display: flex; align-items: center; justify-content: center; color: #12110c;">
            <span class="material-symbols-outlined font-black" style="font-size: 20px;">bolt</span>
          </div>
          <span style="font-size: 20px; font-weight: 900; text-transform: uppercase; color: #fff;">
            {{ shop.name | default: 'ELECTRO' }}
          </span>
        </div>
        <p style="font-size: 13px; line-height: 1.6;">
          {{ section.settings.about_text | default: 'Engineering high-output automotive lighting solutions built to withstand extreme monsoon rains, rough terrains, and zero-visibility midnight highways.' }}
        </p>
        <div style="display: flex; gap: 12px; margin-top: 8px;">
          <a href="#" style="width: 36px; height: 36px; border-radius: 50%; background: var(--color-surface-elevated); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; color: #fff;">
            <span class="material-symbols-outlined" style="font-size: 18px;">share</span>
          </a>
          <a href="#" style="width: 36px; height: 36px; border-radius: 50%; background: var(--color-surface-elevated); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; color: #fff;">
            <span class="material-symbols-outlined" style="font-size: 18px;">mail</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h4 style="font-size: 14px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.05em; margin-bottom: 20px;">
          Quick Links
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
          <li><a href="{{ routes.all_products_collection_url }}" style="color: var(--color-text-muted); hover:color: #fff;">All LED Bulbs</a></li>
          <li><a href="#specs" style="color: var(--color-text-muted);">Technical Specs</a></li>
          <li><a href="#compatibility" style="color: var(--color-text-muted);">Vehicle Fitment Finder</a></li>
          <li><a href="#comparison" style="color: var(--color-text-muted);">Halogen vs LED Comparison</a></li>
          <li><a href="#faq" style="color: var(--color-text-muted);">Warranty & FAQs</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div>
        <h4 style="font-size: 14px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.05em; margin-bottom: 20px;">
          Support & Fitment
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
          <li style="display: flex; gap: 8px; align-items: center;">
            <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 16px;">mail</span>
            <span>support@electro-led.com</span>
          </li>
          <li style="display: flex; gap: 8px; align-items: center;">
            <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 16px;">verified_user</span>
            <span>2-Year Direct Replacement</span>
          </li>
          <li style="display: flex; gap: 8px; align-items: center;">
            <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 16px;">local_shipping</span>
            <span>Worldwide Tracked Shipping</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div>
        <h4 style="font-size: 14px; font-weight: 800; text-transform: uppercase; color: #ffffff; letter-spacing: 0.05em; margin-bottom: 20px;">
          VIP Driver Updates
        </h4>
        <p style="font-size: 13px; margin-bottom: 16px;">
          Receive fitment guides, flash discounts, and new automotive LED product launches.
        </p>
        <form style="display: flex; gap: 8px;">
          <input type="email" placeholder="Enter your email" style="flex: 1; background: var(--color-surface-elevated); border: 1px solid var(--color-border); border-radius: var(--radius-full); padding: 10px 16px; color: #fff; font-size: 12px; outline: none;">
          <button type="submit" class="btn-primary" style="padding: 10px 18px; font-size: 11px;">
            JOIN
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Copyright & Badges -->
    <div style="border-top: 1px solid var(--color-border); padding-top: 30px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; font-size: 12px;">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Electro LED Lighting' }}. All Rights Reserved. Engineered for Extremes.</p>
      
      <div style="display: flex; gap: 16px; align-items: center;">
        <span style="font-weight: 700; color: #fff; text-transform: uppercase; font-size: 11px;">Guaranteed Safe Checkout</span>
        <div style="display: flex; gap: 8px; color: var(--color-primary);">
          <span class="material-symbols-outlined" style="font-size: 20px;">credit_card</span>
          <span class="material-symbols-outlined" style="font-size: 20px;">lock</span>
          <span class="material-symbols-outlined" style="font-size: 20px;">shield</span>
        </div>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Electro Summary",
      "default": "Engineering high-output automotive lighting solutions built to withstand extreme monsoon rains, rough terrains, and zero-visibility midnight highways."
    }
  ]
}
{% endschema %}
