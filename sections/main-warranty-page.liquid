<section class="warranty-page" style="padding: 60px 0 100px; background: #12110c;">
  <div class="page-width">
    
    <!-- Breadcrumb -->
    <nav style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--color-text-muted); margin-bottom: 24px;">
      <a href="{{ routes.root_url }}" style="color: inherit; text-decoration: none;">HOME</a>
      <span>/</span>
      <span style="color: var(--color-primary); font-weight: 700;">2-YEAR WARRANTY & SHIPPING POLICY</span>
    </nav>

    <!-- Header -->
    <div style="text-align: center; max-width: 800px; margin: 0 auto 48px;">
      <span style="font-size: 11px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.25em; display: inline-block; margin-bottom: 12px; padding: 4px 12px; background: rgba(255, 217, 0, 0.1); border-radius: var(--radius-full);">
        HASSLE-FREE GUARANTEE
      </span>
      <h1 style="font-size: clamp(32px, 5vw, 56px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 16px;">
        2-YEAR <span style="color: var(--color-primary);">WARRANTY & SHIPPING</span>
      </h1>
      <p style="font-size: 16px; color: var(--color-text-muted); line-height: 1.6;">
        Every Electro NightEye automotive LED system is built for extreme thermal resilience and tested to military-grade standards. We back every single unit with an ironclad direct replacement guarantee.
      </p>
    </div>

    <!-- 3 Core Pillars -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 64px;">
      
      <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 32px; text-align: center;">
        <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(255,217,0,0.1); border: 1px solid rgba(255,217,0,0.25); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <span class="material-symbols-outlined" style="font-size: 30px; color: var(--color-primary);">verified_user</span>
        </div>
        <h3 style="font-size: 18px; font-weight: 900; text-transform: uppercase; margin-bottom: 12px;">2-YEAR DIRECT REPLACEMENT</h3>
        <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6;">
          If an LED chip fails, fan malfunctions, or moisture enters the housing within 24 months, we ship an immediate brand-new replacement pair. Zero repair wait times.
        </p>
      </div>

      <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 32px; text-align: center;">
        <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(255,217,0,0.1); border: 1px solid rgba(255,217,0,0.25); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <span class="material-symbols-outlined" style="font-size: 30px; color: var(--color-primary);">local_shipping</span>
        </div>
        <h3 style="font-size: 18px; font-weight: 900; text-transform: uppercase; margin-bottom: 12px;">FREE EXPRESS SHIPPING ($75+)</h3>
        <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6;">
          All orders over $75 unlock free tracked courier shipping. Orders ship within 24 business hours from climate-controlled fulfillment centers.
        </p>
      </div>

      <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 32px; text-align: center;">
        <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(255,217,0,0.1); border: 1px solid rgba(255,217,0,0.25); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <span class="material-symbols-outlined" style="font-size: 30px; color: var(--color-primary);">published_with_changes</span>
        </div>
        <h3 style="font-size: 18px; font-weight: 900; text-transform: uppercase; margin-bottom: 12px;">30-DAY TEST DRIVE</h3>
        <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6;">
          Test Electro NightEye on your darkest roads for 30 nights. If you are not completely blown away by the beam cutoff and brightness, return them for a 100% full refund.
        </p>
      </div>

    </div>

    <!-- Warranty Claim Process -->
    <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 40px; margin-bottom: 64px;">
      <h2 style="font-size: 22px; font-weight: 900; text-transform: uppercase; margin-bottom: 24px;">HOW TO FILE A WARRANTY REPLACEMENT</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; font-size: 14px; color: var(--color-text-muted);">
        <div>
          <strong style="color: var(--color-primary); display: block; margin-bottom: 6px;">STEP 1: SNAP A PHOTO OR VIDEO</strong>
          <p>Take a quick photo or 5-second video demonstrating the bulb issue installed in your vehicle.</p>
        </div>
        <div>
          <strong style="color: var(--color-primary); display: block; margin-bottom: 6px;">STEP 2: EMAIL TECH SUPPORT</strong>
          <p>Email our warranty department with your Order ID and vehicle year/make/model.</p>
        </div>
        <div>
          <strong style="color: var(--color-primary); display: block; margin-bottom: 6px;">STEP 3: 24HR TRACKED REPLACEMENT</strong>
          <p>Our lighting specialists approve your claim and dispatch a brand-new replacement pair with tracking.</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div style="text-align: center;">
      <a href="/pages/contact" class="btn-primary" style="padding: 16px 36px; font-size: 14px;">
        SUBMIT WARRANTY INQUIRY
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Warranty Page",
  "settings": []
}
{% endschema %}
