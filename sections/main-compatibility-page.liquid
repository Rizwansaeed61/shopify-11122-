<section class="compatibility-page" style="padding: 60px 0 100px; background: #12110c;">
  <div class="page-width">
    
    <!-- Breadcrumb -->
    <nav style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--color-text-muted); margin-bottom: 24px;">
      <a href="{{ routes.root_url }}" style="color: inherit; text-decoration: none;">HOME</a>
      <span>/</span>
      <span style="color: var(--color-primary); font-weight: 700;">VEHICLE FITMENT & BULB SIZING GUIDE</span>
    </nav>

    <!-- Header -->
    <div style="text-align: center; max-width: 800px; margin: 0 auto 48px;">
      <span style="font-size: 11px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.25em; display: inline-block; margin-bottom: 12px; padding: 4px 12px; background: rgba(255, 217, 0, 0.1); border-radius: var(--radius-full);">
        100% GUARANTEED PLUG & PLAY FITMENT
      </span>
      <h1 style="font-size: clamp(32px, 5vw, 56px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 16px;">
        VEHICLE <span style="color: var(--color-primary);">FITMENT GUIDE</span>
      </h1>
      <p style="font-size: 16px; color: var(--color-text-muted); line-height: 1.6;">
        Find the exact factory halogen replacement bulb size for your vehicle. Our smart Canbus LED kits are engineered to match 1:1 OEM headlight housing dimensions without wiring modifications.
      </p>
    </div>

    <!-- Compatibility Finder Widget -->
    <div class="glass-panel" style="max-width: 840px; margin: 0 auto 64px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 40px 32px; box-shadow: var(--shadow-glow);">
      <h2 style="font-size: 20px; font-weight: 900; text-transform: uppercase; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 26px;">directions_car</span>
        <span>SELECT YOUR VEHICLE SPECIFICATIONS</span>
      </h2>
      {% render 'compatibility-selector' %}
    </div>

    <!-- Bulb Sizing Reference Matrix -->
    <div style="margin-bottom: 64px;">
      <h2 style="font-size: 24px; font-weight: 900; text-transform: uppercase; margin-bottom: 24px; text-align: center;">
        COMMON BULB SIZES & <span style="color: var(--color-primary);">APPLICATIONS</span>
      </h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 22px; font-weight: 900; color: var(--color-primary);">H4 / 9003</span>
            <span style="font-size: 11px; font-weight: 800; background: rgba(255,217,0,0.1); color: var(--color-primary); padding: 4px 8px; border-radius: 4px;">DUAL BEAM</span>
          </div>
          <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 16px;">
            Features both High and Low beam filaments in a single bulb housing. Widely used on Toyota, Honda, Nissan, Suzuki, and commercial trucks.
          </p>
          <a href="/products/electro-nighteye-led" class="btn-secondary" style="display: inline-block; padding: 8px 16px; font-size: 11px; font-weight: 800; width: 100%; text-align: center;">
            VIEW H4 LED KITS
          </a>
        </div>

        <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 22px; font-weight: 900; color: var(--color-primary);">H7</span>
            <span style="font-size: 11px; font-weight: 800; background: rgba(255,217,0,0.1); color: var(--color-primary); padding: 4px 8px; border-radius: 4px;">SINGLE BEAM</span>
          </div>
          <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 16px;">
            Dedicated low-beam or high-beam socket. Standard equipment across European cars (BMW, Mercedes, Audi, VW) and modern Asian crossovers.
          </p>
          <a href="/products/electro-nighteye-led" class="btn-secondary" style="display: inline-block; padding: 8px 16px; font-size: 11px; font-weight: 800; width: 100%; text-align: center;">
            VIEW H7 LED KITS
          </a>
        </div>

        <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 22px; font-weight: 900; color: var(--color-primary);">H11 / H8 / H9</span>
            <span style="font-size: 11px; font-weight: 800; background: rgba(255,217,0,0.1); color: var(--color-primary); padding: 4px 8px; border-radius: 4px;">FOG & LOW BEAM</span>
          </div>
          <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 16px;">
            Universal L-shaped connector socket. Most popular fitment for bumper fog lights and projector low beams on modern sedans and SUVs.
          </p>
          <a href="/products/electro-nighteye-led" class="btn-secondary" style="display: inline-block; padding: 8px 16px; font-size: 11px; font-weight: 800; width: 100%; text-align: center;">
            VIEW H11 LED KITS
          </a>
        </div>

        <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 22px; font-weight: 900; color: var(--color-primary);">HB3 / 9005</span>
            <span style="font-size: 11px; font-weight: 800; background: rgba(255,217,0,0.1); color: var(--color-primary); padding: 4px 8px; border-radius: 4px;">HIGH BEAM</span>
          </div>
          <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 16px;">
            Concentrated high-beam headlight socket. Popular on American trucks, Japanese sedans, and high-speed highway touring vehicles.
          </p>
          <a href="/products/electro-nighteye-led" class="btn-secondary" style="display: inline-block; padding: 8px 16px; font-size: 11px; font-weight: 800; width: 100%; text-align: center;">
            VIEW 9005 LED KITS
          </a>
        </div>
      </div>
    </div>

    <!-- Need Tech Help Strip -->
    <div style="text-align: center; padding: 40px; background: rgba(255,217,0,0.04); border: 1px dashed var(--color-primary); border-radius: var(--radius-md);">
      <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 8px;">UNSURE ABOUT YOUR EXACT VEHICLE FITMENT?</h3>
      <p style="color: var(--color-text-muted); font-size: 14px; margin-bottom: 20px;">
        Our certified automotive lighting engineers can look up your exact chassis code and provide 100% guaranteed fitment confirmation in minutes.
      </p>
      <a href="/pages/contact" class="btn-primary" style="padding: 12px 28px; font-size: 13px;">
        ASK A LIGHTING SPECIALIST
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Compatibility Page",
  "settings": []
}
{% endschema %}
