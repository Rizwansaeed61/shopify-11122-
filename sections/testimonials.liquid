<section class="testimonials-section" style="padding: 100px 0; background: #12110c;">
  <div class="page-width">
    
    <div style="text-align: center; max-width: 680px; margin: 0 auto 60px;">
      <span style="font-size: 12px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: 8px;">
        {{ section.settings.eyebrow | default: 'VERIFIED HIGHWAY REVIEWS' }}
      </span>
      <h2 style="font-size: clamp(32px, 5vw, 56px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em;">
        {{ section.settings.title | default: 'WHAT DRIVERS <span style="color: var(--color-primary);">SAY</span>' }}
      </h2>
      <p style="font-size: 16px; color: var(--color-text-muted); margin-top: 14px;">
        {{ section.settings.subtitle | default: 'Real feedback from over 25,000+ drivers who trust Electro NightEye for unmatched nighttime road safety.' }}
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
      {%- for block in section.blocks -%}
        <div class="glass-panel neon-border" style="padding: 32px; border-radius: var(--radius-md); display: flex; flex-direction: column; justify-content: space-between;" {{ block.shopify_attributes }}>
          <div>
            <div style="display: flex; gap: 4px; margin-bottom: 16px;">
              {% for i in (1..5) %}
                <span class="material-symbols-outlined" style="font-size: 18px; color: var(--color-primary); font-variation-settings: 'FILL' 1;">star</span>
              {% endfor %}
            </div>
            <p style="font-size: 15px; color: #ffffff; line-height: 1.7; font-style: italic; margin-bottom: 24px;">
              "{{ block.settings.quote }}"
            </p>
          </div>

          <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border); padding-top: 16px;">
            <div>
              <h4 style="font-size: 15px; font-weight: 800; text-transform: uppercase;">{{ block.settings.author }}</h4>
              <span style="font-size: 12px; color: var(--color-text-muted);">{{ block.settings.vehicle }}</span>
            </div>
            <span style="display: inline-flex; align-items: center; gap: 4px; background: rgba(40, 169, 86, 0.15); color: #28a956; border: 1px solid rgba(40, 169, 86, 0.3); font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: var(--radius-full);">
              <span class="material-symbols-outlined" style="font-size: 14px;">verified</span>
              VERIFIED
            </span>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "VERIFIED HIGHWAY REVIEWS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WHAT DRIVERS <span style='color: #ffd900;'>SAY</span>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real feedback from over 25,000+ drivers who trust Electro NightEye for unmatched nighttime road safety."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review Card",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "Unbelievable difference on highway night trips. The beam cutoff is razor sharp so nobody flashes their high beams at me, yet the road ahead is as clear as daytime."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Vikram S."
        },
        {
          "type": "text",
          "id": "vehicle",
          "label": "Vehicle Model",
          "default": "Toyota Fortuner Owner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "Unbelievable difference on unlit rural highways. The beam cutoff is razor sharp so nobody flashes their lights at me, yet the road ahead is as clear as daytime.",
            "author": "Marcus Thorne",
            "vehicle": "Ford F-150 (H11 Low Beam)"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Direct 5-minute plug and play installation on my Civic. Zero error codes on the dashboard and completely waterproof during torrential monsoon downpours.",
            "author": "Rahul Mehta",
            "vehicle": "Honda Civic (H7)"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The 6500K cool white light penetrates through dense fog without yellowing or overheating. By far the highest quality LED upgrade I've ever installed.",
            "author": "David Vance",
            "vehicle": "Toyota 4Runner (H4 Dual Beam)"
          }
        }
      ]
    }
  ]
}
{% endschema %}
