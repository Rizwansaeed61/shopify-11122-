<section class="about-page" style="padding: 60px 0 100px; background: #12110c;">
  <div class="page-width">
    
    <!-- Breadcrumb -->
    <nav style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--color-text-muted); margin-bottom: 24px;">
      <a href="{{ routes.root_url }}" style="color: inherit; text-decoration: none;">HOME</a>
      <span>/</span>
      <span style="color: var(--color-primary); font-weight: 700;">ABOUT ELECTRO AUTOMOTIVE</span>
    </nav>

    <!-- Header -->
    <div style="text-align: center; max-width: 800px; margin: 0 auto 56px;">
      <span style="font-size: 11px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.25em; display: inline-block; margin-bottom: 12px; padding: 4px 12px; background: rgba(255, 217, 0, 0.1); border-radius: var(--radius-full);">
        PRECISION RACING OPTICS & THERMAL DYNAMICS
      </span>
      <h1 style="font-size: clamp(32px, 5vw, 56px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 16px;">
        ENGINEERED FOR <span style="color: var(--color-primary);">THE DARKEST ROADS</span>
      </h1>
      <p style="font-size: 16px; color: var(--color-text-muted); line-height: 1.6;">
        Electro Automotive was founded by motorsport lighting engineers with one single mission: eliminate highway blind spots and replace dim, obsolete halogen headlights with industrial-grade, surgical LED optics.
      </p>
    </div>

    <!-- 2 Column Mission & Lab Story -->
    <div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-bottom: 80px;">
      <div>
        <span style="font-size: 11px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: 8px;">
          LAB TESTED BENCHMARKS
        </span>
        <h2 style="font-size: clamp(26px, 3vw, 36px); font-weight: 900; text-transform: uppercase; line-height: 1.2; margin-bottom: 20px;">
          WHERE MILITARY SPEC MEETS <span style="color: var(--color-primary);">HIGHWAY SAFETY</span>
        </h2>
        <p style="font-size: 15px; color: var(--color-text-muted); line-height: 1.7; margin-bottom: 16px;">
          Standard OEM halogen bulbs produce an average of 1,200 lumens with weak, yellow illumination that fades after 500 hours. Generic budget LEDs frequently scatter unfocused light, causing dangerous blinding glare for oncoming motorists and triggering ECU dashboard error codes.
        </p>
        <p style="font-size: 15px; color: var(--color-text-muted); line-height: 1.7; margin-bottom: 24px;">
          At Electro, we machine every single NightEye housing from solid aircraft-grade 6063 aluminum, mount custom-engineered CSP micro-arrays onto double-sided red copper substrates, and integrate active 12,000 RPM hydraulic turbo fans to maintain consistent 15,000 LM illumination over 50,000 continuous hours.
        </p>

        <div style="display: flex; gap: 32px; border-top: 1px solid var(--color-border); padding-top: 24px;">
          <div>
            <div style="font-size: 32px; font-weight: 900; color: var(--color-primary);">15,000</div>
            <div style="font-size: 12px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">Lumens Output</div>
          </div>
          <div>
            <div style="font-size: 32px; font-weight: 900; color: #fff;">50,000+</div>
            <div style="font-size: 12px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">Hours Lifespan</div>
          </div>
          <div>
            <div style="font-size: 32px; font-weight: 900; color: #28a956;">99.9%</div>
            <div style="font-size: 12px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase;">Canbus Success</div>
          </div>
        </div>
      </div>

      <!-- Feature Image Showcase -->
      <div class="glass-panel" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 32px; text-align: center;">
        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAND8qMhd2pMpwyXo2dJR417sLYkrXtb3jG7hFgq91krJo7_DVFtACJaJoMZIj1Sdms2xakavJlHGCoI8U4KgKk7BBUTG3QCTBn7WL9Tlm3GOoRi4Kxml7I0Vxso9dESfsxELI-wTQrkMKb1Px77sRRrrwIg48vuTF9SxSP2y5cG6Aq6Kj4DSweRaKFdxn_yU6Q0FSmmWGp1GdUVpoIkZ88Rr9GIWKxuHrM6zXzunCN0RfGAEWH7pUPmcArPrbMgwgvT4DDXc-b2v5N" alt="Electro NightEye Engineering" width="480" height="480" style="width: 100%; max-width: 400px; object-fit: contain; margin: 0 auto 20px;">
        <h4 style="font-size: 16px; font-weight: 800; text-transform: uppercase; color: #fff;">PRECISION CNC AIRCRAFT ALUMINUM HOUSING</h4>
        <p style="font-size: 13px; color: var(--color-text-muted); margin-top: 4px;">Thermal heat dissipation benchmarked under severe 85°C continuous testing.</p>
      </div>
    </div>

    <!-- CTA Strip -->
    <div style="text-align: center; background: rgba(255,217,0,0.06); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 48px 32px;">
      <h2 style="font-size: 28px; font-weight: 900; text-transform: uppercase; margin-bottom: 12px;">EXPERIENCE NIGHTTIME CLARITY LIKE NEVER BEFORE</h2>
      <p style="font-size: 15px; color: var(--color-text-muted); max-width: 600px; margin: 0 auto 24px;">
        Join over 25,000+ verified motorists who have upgraded to Electro NightEye automotive LED systems.
      </p>
      <a href="/products/electro-nighteye-led" class="btn-primary" style="padding: 16px 36px; font-size: 14px;">
        ORDER NIGHTEYE LED NOW
      </a>
    </div>

  </div>
</section>

