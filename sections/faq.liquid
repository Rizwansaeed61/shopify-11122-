<section id="faq" class="faq-section" style="padding: 100px 0; background: #181710; border-top: 1px solid var(--color-border);">
  <div class="page-width" style="max-width: 840px;">
    
    <div style="text-align: center; margin-bottom: 50px;">
      <span style="font-size: 12px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: 8px;">
        {{ section.settings.eyebrow | default: 'SUPPORT & FITMENT HELP' }}
      </span>
      <h2 style="font-size: clamp(30px, 4vw, 50px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em;">
        {{ section.settings.title | default: 'COMMON <span style="color: var(--color-primary);">QUESTIONS</span>' }}
      </h2>
    </div>

    <div class="faq-accordion-list">
      {%- for block in section.blocks -%}
        <div class="accordion-item" {{ block.shopify_attributes }}>
          <div class="accordion-header">
            <span style="font-size: 16px; font-weight: 800;">{{ block.settings.question }}</span>
            <span class="material-symbols-outlined" style="color: var(--color-primary); font-size: 20px;">expand_more</span>
          </div>
          <div class="accordion-content">
            <p>{{ block.settings.answer }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SUPPORT & FITMENT HELP"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "COMMON <span style='color: #ffd900;'>QUESTIONS</span>"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Will these bulbs cause a Canbus dashboard error code?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "No. Electro NightEye LED features built-in high-precision intelligent decoders compatible with 99.9% of modern European, American, and Asian vehicle ECUs without flickering or bulb-out warnings."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Will these bulbs trigger a Canbus dashboard error light?",
            "answer": "No. Electro NightEye LEDs feature integrated micro-decoders that replicate OEM halogen resistance, ensuring 99.9% error-free operation without ECU warning lights or flickering."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How difficult is the installation process?",
            "answer": "It is completely plug-and-play. They are engineered to 1:1 OEM dimensions. Simply unplug your old factory bulb and twist in the Electro LED. Most drivers complete installation in under 10 minutes per headlight."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Will these headlights blind oncoming drivers?",
            "answer": "No. Our ultra-thin 1.0mm copper board positions the CSP chips at the exact focal point of factory reflector and projector housings, creating a razor-sharp horizontal cutoff line with zero stray upward glare."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What does the 2-Year Warranty cover?",
            "answer": "Our warranty provides full 100% no-hassle replacement coverage for any manufacturing defect, chip failure, fan malfunction, or water intrusion for a full 24 months from purchase date."
          }
        }
      ]
    }
  ]
}
{% endschema %}
