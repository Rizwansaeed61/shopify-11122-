<section id="comparison" class="comparison-section" style="padding: 100px 0; background: #12110c;">
  <div class="page-width">
    
    <div style="text-align: center; max-width: 760px; margin: 0 auto 50px;">
      <span style="font-size: 12px; font-weight: 900; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.2em; display: block; margin-bottom: 8px;">
        {{ section.settings.eyebrow | default: 'DATA-BACKED SUPERIORITY' }}
      </span>
      <h2 style="font-size: clamp(28px, 5vw, 52px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em;">
        {{ section.settings.title | default: 'SUPERIORITY <span style="color: var(--color-primary);">ENGINEERED</span>' }}
      </h2>
      <p style="font-size: 16px; color: var(--color-text-muted); margin-top: 14px;">
        {{ section.settings.subtitle | default: 'See how Electro NightEye LED outperforms stock factory halogens and generic budget LEDs across every critical safety metric.' }}
      </p>
    </div>

    <!-- Responsive Comparison Table -->
    <div class="comparison-table-wrapper">
      <table class="comparison-table">
        <thead>
          <tr>
            <th style="width: 28%;">Feature / Metric</th>
            <th class="col-highlight" style="width: 28%; text-align: center;">
              <span style="display: inline-block; background: var(--color-primary); color: #12110c; font-size: 10px; font-weight: 900; padding: 2px 8px; border-radius: var(--radius-full); margin-bottom: 6px;">PRO SERIES</span>
              <div style="font-size: 16px; font-weight: 900; color: #ffffff;">Electro NightEye LED</div>
            </th>
            <th style="width: 22%; text-align: center; color: var(--color-text-muted);">OEM Halogen</th>
            <th style="width: 22%; text-align: center; color: var(--color-text-muted);">Generic Budget LED</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="font-weight: 700; color: #ffffff;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="material-symbols-outlined" style="font-size: 18px; color: var(--color-primary);">{{ block.settings.icon | default: 'check_circle' }}</span>
                  <span>{{ block.settings.metric }}</span>
                </div>
              </td>
              <td class="col-highlight" style="text-align: center; font-weight: 800; color: var(--color-primary);">
                {{ block.settings.electro_val }}
              </td>
              <td style="text-align: center; color: var(--color-text-muted);">
                {{ block.settings.halogen_val }}
              </td>
              <td style="text-align: center; color: var(--color-text-muted);">
                {{ block.settings.generic_val }}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "DATA-BACKED SUPERIORITY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SUPERIORITY <span style='color: #ffd900;'>ENGINEERED</span>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "See how Electro NightEye LED outperforms stock factory halogens and generic budget LEDs across every critical safety metric."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "bolt"
        },
        {
          "type": "text",
          "id": "metric",
          "label": "Metric Name",
          "default": "Light Output (Lumens)"
        },
        {
          "type": "text",
          "id": "electro_val",
          "label": "Electro Value (Highlight)",
          "default": "15,000 LM"
        },
        {
          "type": "text",
          "id": "halogen_val",
          "label": "Halogen Value",
          "default": "1,200 LM"
        },
        {
          "type": "text",
          "id": "generic_val",
          "label": "Generic LED Value",
          "default": "6,000 LM"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "icon": "wb_sunny",
            "metric": "Lumen Output",
            "electro_val": "15,000 LM (300% Brighter)",
            "halogen_val": "1,200 LM (Dim Yellow)",
            "generic_val": "6,000 LM (Exaggerated)"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "schedule",
            "metric": "Operational Lifespan",
            "electro_val": "50,000+ Hours",
            "halogen_val": "500 - 1,000 Hours",
            "generic_val": "8,000 Hours"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "water_drop",
            "metric": "Water & Dust Proofing",
            "electro_val": "IP68 Submersible",
            "halogen_val": "Unsealed / Open Back",
            "generic_val": "IP65 Splashes Only"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "air",
            "metric": "Thermal Dissipation",
            "electro_val": "12,000 RPM Silent Turbo Fan",
            "halogen_val": "Passive Glass Filament",
            "generic_val": "Cheap Aluminum Fin"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "verified_user",
            "metric": "Direct Warranty",
            "electro_val": "2-Year Full Replacement",
            "halogen_val": "None / 30 Days",
            "generic_val": "No Official Warranty"
          }
        }
      ]
    }
  ]
}
{% endschema %}
