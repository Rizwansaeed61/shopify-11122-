<div class="password-page-content" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 48px 32px; box-shadow: var(--shadow-glow);">
  <!-- Brand Logo -->
  <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 14px; background: var(--color-primary); color: #12110c; margin-bottom: 24px;">
    <span class="material-symbols-outlined font-black" style="font-size: 36px;">bolt</span>
  </div>

  <h1 style="font-size: 32px; font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: 12px;">
    {{ section.settings.heading | default: 'OPENING SOON' }}
  </h1>

  <p style="color: var(--color-text-muted); font-size: 15px; line-height: 1.6; margin-bottom: 32px;">
    {{ section.settings.text | default: 'Our high-performance automotive LED lighting systems are launching shortly. Enter the store password to view the pre-release catalogue.' }}
  </p>

  <!-- Store Password Form -->
  {% form 'storefront_password', class: 'password-form' %}
    {%- if form.errors -%}
      <div style="background: rgba(255, 68, 68, 0.15); border: 1px solid #ff4444; color: #ff8888; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 13px;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div style="display: flex; gap: 10px; max-width: 440px; margin: 0 auto 24px;">
      <input
        type="password"
        name="password"
        id="Password"
        class="form-input"
        placeholder="Enter store password"
        style="flex: 1; padding: 14px 18px; border-radius: 8px; background: var(--color-surface-elevated); border: 1px solid var(--color-border); color: #fff; font-size: 14px;"
        autocomplete="current-password"
      >
      <button type="submit" class="btn-primary" style="padding: 14px 24px; font-size: 13px; white-space: nowrap;">
        ENTER STORE
      </button>
    </div>
  {% endform %}

  <div style="border-top: 1px solid var(--color-border); padding-top: 20px; font-size: 13px; color: var(--color-text-muted);">
    Are you the store owner? <a href="/admin" style="color: var(--color-primary); font-weight: 700; text-decoration: underline;">Log in here</a>
  </div>
</div>

{% schema %}
{
  "name": "Main Password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OPENING SOON"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Our high-performance automotive LED lighting systems are launching shortly. Enter the store password to view the pre-release catalogue."
    }
  ]
}
{% endschema %}
