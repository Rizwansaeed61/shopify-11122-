<!doctype html>
<html class="no-js dark" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#12110c">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% render 'seo-head' %}
    {% render 'seo-schema' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-to-content-link" href="#MainContent" style="position: absolute; left: -9999px;">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Cart Drawer -->
    <div id="CartDrawerOverlay" class="cart-drawer-overlay"></div>
    <div id="CartDrawer" class="cart-drawer">
      <div style="padding: 20px 24px; border-bottom: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="material-symbols-outlined" style="color: var(--color-primary);">shopping_bag</span>
          <h3 style="font-size: 16px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'sections.cart.title' | t }}</h3>
        </div>
        <button type="button" data-close-cart style="background: none; border: none; color: #fff; cursor: pointer; padding: 4px;" aria-label="Close Cart">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <!-- Free Shipping Mini Bar -->
      <div style="padding: 12px 24px; background: rgba(255, 217, 0, 0.06); border-bottom: 1px solid var(--color-border);">
        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 11px; font-weight: 800; margin-bottom: 6px;">
          <span style="color: var(--color-primary); display: flex; align-items: center; gap: 4px;">
            <span class="material-symbols-outlined" style="font-size: 14px;">local_shipping</span>
            FREE WORLDWIDE EXPRESS SHIPPING
          </span>
          <span style="color: #28a956;">UNLOCKED!</span>
        </div>
        <div style="height: 4px; background: var(--color-surface-elevated); border-radius: var(--radius-full); overflow: hidden;">
          <div style="width: 100%; height: 100%; background: var(--color-primary); border-radius: var(--radius-full);"></div>
        </div>
      </div>

      <!-- Items List -->
      <div id="CartDrawerItems" style="flex: 1; padding: 24px; overflow-y: auto;">
        {%- if cart.item_count > 0 -%}
          {%- for item in cart.items -%}
            <div style="display: flex; gap: 16px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--color-border);">
              {%- if item.image != blank -%}
                <img src="{{ item.image | image_url: width: 120 }}" width="64" height="64" style="border-radius: 8px; object-fit: cover; background: var(--color-surface-elevated);">
              {%- else -%}
                <div style="width: 64px; height: 64px; border-radius: 8px; background: var(--color-surface-elevated); display: flex; align-items: center; justify-content: center;">
                  <span class="material-symbols-outlined" style="color: var(--color-primary);">bolt</span>
                </div>
              {%- endif -%}
              <div style="flex: 1;">
                <h4 style="font-size: 14px; font-weight: 700; text-transform: uppercase;">{{ item.product.title }}</h4>
                <p style="font-size: 12px; color: var(--color-text-muted);">{{ item.variant.title }}</p>
                <div style="display: flex; justify-content: space-between; margin-top: 8px; align-items: center;">
                  <span style="color: var(--color-primary); font-weight: 800;">{{ item.final_line_price | money }}</span>
                  <span style="font-size: 12px; color: var(--color-text-muted);">Qty: {{ item.quantity }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Demo Cart Item for Initial Preview -->
          <div id="DrawerDemoItem" style="display: flex; gap: 16px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--color-border);">
            <div style="width: 68px; height: 68px; border-radius: 8px; background: var(--color-surface-elevated); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
              <img id="DrawerItemImage" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAND8qMhd2pMpwyXo2dJR417sLYkrXtb3jG7hFgq91krJo7_DVFtACJaJoMZIj1Sdms2xakavJlHGCoI8U4KgKk7BBUTG3QCTBn7WL9Tlm3GOoRi4Kxml7I0Vxso9dESfsxELI-wTQrkMKb1Px77sRRrrwIg48vuTF9SxSP2y5cG6Aq6Kj4DSweRaKFdxn_yU6Q0FSmmWGp1GdUVpoIkZ88Rr9GIWKxuHrM6zXzunCN0RfGAEWH7pUPmcArPrbMgwgvT4DDXc-b2v5N" alt="NightEye LED" width="68" height="68" style="object-fit: contain; width: 100%; height: 100%;">
            </div>
            <div style="flex: 1;">
              <h4 id="DrawerItemTitle" style="font-size: 13px; font-weight: 800; text-transform: uppercase;">Electro NightEye LED H4</h4>
              <p style="font-size: 11px; color: var(--color-text-muted); margin-top: 2px;">Dual Beam • 15,000 LM • 6500K White</p>
              <div style="display: flex; justify-content: space-between; margin-top: 8px; align-items: center;">
                <span id="DrawerItemPrice" style="color: var(--color-primary); font-weight: 800; font-size: 14px;">$89.00</span>
                <span style="font-size: 11px; color: var(--color-text-muted); background: var(--color-surface-elevated); padding: 2px 8px; border-radius: 4px;">Qty: 1</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Drawer Footer -->
      <div style="padding: 20px 24px; border-top: 1px solid var(--color-border); background: var(--color-surface-elevated);">
        <div style="display: flex; justify-content: space-between; margin-bottom: 14px;">
          <span style="font-weight: 700; font-size: 14px;">{{ 'sections.cart.subtotal' | t }}</span>
          <span style="font-weight: 900; color: var(--color-primary); font-size: 18px;">{{ cart.total_price | default: 8900 | money }}</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px;">
          <a href="/checkout" class="btn-primary" style="width: 100%; text-align: center; padding: 14px; font-size: 14px; font-weight: 900; display: flex; align-items: center; justify-content: center; gap: 8px;">
            <span class="material-symbols-outlined" style="font-size: 18px;">lock</span>
            <span>{{ 'sections.cart.checkout' | t | upcase }}</span>
          </a>

          <a href="{{ routes.cart_url }}" class="btn-secondary" style="width: 100%; text-align: center; padding: 10px; font-size: 12px; font-weight: 700;">
            VIEW CART & VEHICLE NOTE
          </a>
        </div>

        <!-- Payment Badges in Drawer -->
        <div style="margin-top: 16px; text-align: center;">
          <div style="display: flex; justify-content: center; gap: 6px; font-size: 9px; font-weight: 900; margin-bottom: 8px;">
            <span style="background: #fff; color: #1a1f36; padding: 2px 6px; border-radius: 3px;">VISA</span>
            <span style="background: #fff; color: #eb001b; padding: 2px 6px; border-radius: 3px;">MC</span>
            <span style="background: #006fcf; color: #fff; padding: 2px 6px; border-radius: 3px;">AMEX</span>
            <span style="background: #000; color: #fff; padding: 2px 6px; border-radius: 3px; border: 1px solid rgba(255,255,255,0.2);">APPLE PAY</span>
            <span style="background: #5a31f4; color: #fff; padding: 2px 6px; border-radius: 3px;">SHOP PAY</span>
          </div>
          <span style="font-size: 10px; color: var(--color-text-muted); display: inline-flex; align-items: center; gap: 4px;">
            <span class="material-symbols-outlined" style="font-size: 12px; color: #28a956;">verified_user</span> 256-Bit SSL Encrypted Checkout
          </span>
        </div>
      </div>
    </div>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
