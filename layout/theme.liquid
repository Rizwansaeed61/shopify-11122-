<!doctype html>
<html class="no-js dark" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#12110c">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {%- if template.name == 'index' -%}
        {{ shop.name | default: 'Electro' }} &ndash; Industrial Grade Automotive LED Lighting
      {%- else -%}
        {{ page_title }}
        {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
        {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-to-content-link" href="#MainContent" style="position: absolute; left: -9999px;">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Cart Drawer -->
    <div id="CartDrawerOverlay" class="cart-drawer-overlay"></div>
    <div id="CartDrawer" class="cart-drawer">
      <div style="padding: 24px; border-bottom: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between;">
        <h3 style="font-size: 18px; font-weight: 800; text-transform: uppercase;">{{ 'sections.cart.title' | t }}</h3>
        <button type="button" data-close-cart style="background: none; border: none; color: #fff; cursor: pointer;">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div style="flex: 1; padding: 24px; overflow-y: auto;">
        {%- if cart.item_count > 0 -%}
          {%- for item in cart.items -%}
            <div style="display: flex; gap: 16px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--color-border);">
              {%- if item.image != blank -%}
                <img src="{{ item.image | image_url: width: 120 }}" width="64" height="64" style="border-radius: 8px; object-fit: cover;">
              {%- else -%}
                <div style="width: 64px; height: 64px; border-radius: 8px; background: var(--color-surface-elevated); display: flex; align-items: center; justify-content: center;">
                  <span class="material-symbols-outlined" style="color: var(--color-primary);">bolt</span>
                </div>
              {%- endif -%}
              <div style="flex: 1;">
                <h4 style="font-size: 14px; font-weight: 700;">{{ item.product.title }}</h4>
                <p style="font-size: 12px; color: var(--color-text-muted);">{{ item.variant.title }}</p>
                <div style="display: flex; justify-content: space-between; margin-top: 8px; align-items: center;">
                  <span style="color: var(--color-primary); font-weight: 800;">{{ item.final_line_price | money }}</span>
                  <span style="font-size: 12px; color: var(--color-text-muted);">Qty: {{ item.quantity }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Demo Cart Item for Initial Preview -->
          <div style="display: flex; gap: 16px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--color-border);">
            <div style="width: 64px; height: 64px; border-radius: 8px; background: var(--color-surface-elevated); display: flex; align-items: center; justify-content: center;">
              <span class="material-symbols-outlined text-primary" style="color: var(--color-primary);">bolt</span>
            </div>
            <div style="flex: 1;">
              <h4 style="font-size: 14px; font-weight: 700;">Electro NightEye LED</h4>
              <p style="font-size: 12px; color: var(--color-text-muted);">Fitment: H4 (High/Low Beam)</p>
              <div style="display: flex; justify-content: space-between; margin-top: 8px; align-items: center;">
                <span style="color: var(--color-primary); font-weight: 800;">$89.00</span>
                <span style="font-size: 12px; color: var(--color-text-muted);">Qty: 1</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
      <div style="padding: 24px; border-top: 1px solid var(--color-border); background: var(--color-surface-elevated);">
        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
          <span style="font-weight: 700;">{{ 'sections.cart.subtotal' | t }}</span>
          <span style="font-weight: 800; color: var(--color-primary);">{{ cart.total_price | default: 8900 | money }}</span>
        </div>
        <a href="/checkout" class="btn-primary" style="width: 100%; text-align: center;">
          {{ 'sections.cart.checkout' | t }}
        </a>
      </div>
    </div>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
