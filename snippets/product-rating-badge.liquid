{%- comment -%}
  Renders product star rating badge with review anchor
  Usage:
  {% render 'product-rating-badge' %}
{%- endcomment -%}

<div class="product-rating-badge" style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 8px;">
  <div style="display: flex; gap: 2px;">
    {% for i in (1..5) %}
      <span class="material-symbols-outlined" style="font-size: 18px; color: var(--color-primary); font-variation-settings: 'FILL' 1;">star</span>
    {% endfor %}
  </div>
  <a href="#product_reviews" style="font-size: 13px; font-weight: 800; color: #ffffff; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
    <span>4.9 / 5.0</span>
    <span style="color: var(--color-text-muted); font-weight: 600;">(348 Reviews)</span>
  </a>
</div>
