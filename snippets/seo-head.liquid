{%- comment -%}
  Automotive SEO Meta & Social Tags Snippet
  Usage: {% render 'seo-head' %}
{%- endcomment -%}

{%- liquid
  assign seo_title = page_title
  if current_tags
    assign meta_tags = current_tags | join: ', '
    assign seo_title = seo_title | append: ' – Tagged "' | append: meta_tags | append: '"'
  endif
  if current_page != 1
    assign seo_title = seo_title | append: ' – Page ' | append: current_page
  endif
  unless seo_title contains shop.name
    assign seo_title = seo_title | append: ' | ' | append: shop.name
  endunless

  if page_description
    assign seo_description = page_description | escape
  elsif template.name == 'product'
    assign seo_description = product.description | strip_html | truncate: 160 | escape
  elsif template.name == 'collection'
    assign seo_description = collection.description | strip_html | truncate: 160 | default: 'Shop high-performance automotive LED conversion kits, Canbus error-free headlight bulbs, and all-weather fog lighting.' | escape
  else
    assign seo_description = shop.name | append: ' – Industrial-grade automotive LED lighting systems engineered for extreme road visibility, razor-sharp cutoff beams, and Canbus error-free reliability.' | escape
  endif

  assign canonical_url_clean = canonical_url | default: shop.url
-%}

<title>{{ seo_title }}</title>
<meta name="description" content="{{ seo_description }}">

{%- unless request.design_mode -%}
  <link rel="canonical" href="{{ canonical_url_clean }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endunless -%}

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url_clean }}">
<meta property="og:title" content="{{ seo_title }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:description" content="{{ seo_description }}">

{%- if template.name == 'product' and product.featured_image -%}
  <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- elsif page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title }}">
<meta name="twitter:description" content="{{ seo_description }}">
{%- if template.name == 'product' and product.featured_image -%}
  <meta name="twitter:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
{%- elsif page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}
