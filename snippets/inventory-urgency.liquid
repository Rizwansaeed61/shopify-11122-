{%- comment -%}
  Renders live stock inventory urgency indicator
  Usage:
  {% render 'inventory-urgency' %}
{%- endcomment -%}

<div class="inventory-urgency-badge" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 85, 85, 0.1); border: 1px solid rgba(255, 85, 85, 0.3); padding: 6px 14px; border-radius: var(--radius-full); margin: 6px 0;">
  <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ff5555; box-shadow: 0 0 8px #ff5555; animation: pulse-red 1.5s infinite;"></span>
  <span style="font-size: 12px; font-weight: 800; color: #ff8888; text-transform: uppercase; letter-spacing: 0.05em;">
    HIGH DEMAND: Only 7 Pairs Left In Warehouse
  </span>
</div>

<style>
@keyframes pulse-red {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.95); opacity: 0.8; }
}
</style>
